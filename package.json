    "configuration": {
      "title": "ZooKeeper Viewer",
      "properties": {
        "zkViewer.sessionTimeout": {
          "type": "number",
          "default": 10000,
          "description": "%configuration.sessionTimeout.description%"
        },
        "zkViewer.maxReconnectAttempts": {
          "type": "number",
          "default": 3,
          "description": "%configuration.maxReconnectAttempts.description%"
        },
        "zkViewer.reconnectDelayMs": {
          "type": "number",
          "default": 2000,
          "description": "%configuration.reconnectDelayMs.description%"
        },
        "zkViewer.maxSearchNodes": {
          "type": "number",
          "default": 500000,
          "description": "%configuration.maxSearchNodes.description%"
        },
        "zkViewer.maxNodeDataBytes": {
          "type": "number",
          "default": 0,
          "description": "%configuration.maxNodeDataBytes.description%"
        },
        "zkViewer.treeSort": {
          "type": "string",
          "enum": [
            "name",
            "name-desc",
            "ctime",
            "ctime-desc",
            "mtime",
            "mtime-desc",
            "none"
          ],
          "default": "name",
          "description": "%configuration.treeSort.description%"
        },
        "zkViewer.uiLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "zh-cn",
            "en"
          ],
          "default": "auto",
          "scope": "application",
          "description": "%configuration.uiLanguage.description%"
        },
        "zkViewer.dev.useMockClient": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%configuration.dev.useMockClient.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:unit": "npm run compile && mocha \"out/test/unit/**/*.test.js\"",
    "test:unit:cov": "npm run compile && c8 mocha \"out/test/unit/**/*.test.js\"",
    "test:perf": "npm run compile && mocha \"out/test/perf/**/*.test.js\" --timeout 30000",
    "test:integration": "npm run compile && node scripts/run-integration-tests.js",
    "vscode:prepublish": "npm run compile",
    "prepackage": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\"",
    "package": "vsce package --out dist/zk-viewer-vscode.vsix"
  },
  "dependencies": {
    "node-zookeeper-client": "^1.1.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/node-zookeeper-client": "^1.1.0",
    "@types/vscode": "1.60.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "c8": "^10.0.0",
    "eslint": "^9.0.0",
    "mocha": "^10.8.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
