{
  "name": "zk-viewer-vscode",
  "displayName": "ZooKeeper Viewer",
  "description": "Lightweight visual ZooKeeper client for VS Code: browse, search, edit, add and delete nodes with JSON support.",
  "version": "0.1.0",
  "publisher": "zk-viewer",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BeWaterMyFriend7/zk-viewer-vscode.git"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onView:zkViewer.tree",
    "onCommand:zkViewer.connect",
    "onCommand:zkViewer.disconnect",
    "onCommand:zkViewer.addConnection",
    "onCommand:zkViewer.editConnection",
    "onCommand:zkViewer.removeConnection",
    "onCommand:zkViewer.refresh",
    "onCommand:zkViewer.search",
    "onCommand:zkViewer.gotoPath",
    "onCommand:zkViewer.addNode",
    "onCommand:zkViewer.editNode",
    "onCommand:zkViewer.deleteNode",
    "onCommand:zkViewer.copyPath",
    "onCommand:zkViewer.exportNodeData",
    "onCommand:zkViewer.exportNodeData.zh",
    "onCommand:zkViewer.exportNodeData.en",
    "onCommand:zkViewer.exportSubtreeData",
    "onCommand:zkViewer.exportSubtreeData.zh",
    "onCommand:zkViewer.exportSubtreeData.en",
    "onCommand:zkViewer.importNodeData",
    "onCommand:zkViewer.importNodeData.zh",
    "onCommand:zkViewer.importNodeData.en",
    "onCommand:zkViewer.openImportFormat",
    "onCommand:zkViewer.openImportFormat.zh",
    "onCommand:zkViewer.openImportFormat.en",
    "onCommand:zkViewer.setLanguage",
    "onCommand:zkViewer.setLanguage.zh",
    "onCommand:zkViewer.setLanguage.en",
    "onCommand:zkViewer.openNodeDetail",
    "onCommand:zkViewer.setTreeSort",
    "onCommand:zkViewer.searchSubtree"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zkViewer",
          "title": "ZooKeeper",
          "icon": "media/zk.svg"
        }
      ]
    },
    "views": {
      "zkViewer": [
        {
          "id": "zkViewer.tree",
          "name": "ZooKeeper Nodes",
          "icon": "media/zk.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "zkViewer.connect",
        "title": "Connect",
        "category": "ZooKeeper",
        "icon": "$(plug)"
      },
      {
        "command": "zkViewer.disconnect",
        "title": "Disconnect",
        "category": "ZooKeeper",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "zkViewer.addConnection",
        "title": "Add Connection...",
        "category": "ZooKeeper",
        "icon": "$(add)"
      },
      {
        "command": "zkViewer.editConnection",
        "title": "Edit Connection...",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.removeConnection",
        "title": "Remove Connection...",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.refresh",
        "title": "Refresh",
        "category": "ZooKeeper",
        "icon": "$(refresh)"
      },
      {
        "command": "zkViewer.search",
        "title": "Search Nodes...",
        "category": "ZooKeeper",
        "icon": "$(search)"
      },
      {
        "command": "zkViewer.gotoPath",
        "title": "Go to Path...",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.addNode",
        "title": "Add Node...",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.editNode",
        "title": "Edit Node Data",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.deleteNode",
        "title": "Delete Node",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.copyPath",
        "title": "Copy Path",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.exportNodeData",
        "title": "%command.exportNodeData.title%",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.exportSubtreeData",
        "title": "%command.exportSubtreeData.title%",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.importNodeData",
        "title": "%command.importNodeData.title%",
        "category": "ZooKeeper",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "zkViewer.importNodeData.zh",
        "title": "导入节点数据...",
        "category": "ZooKeeper",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "zkViewer.importNodeData.en",
        "title": "Import Node Data...",
        "category": "ZooKeeper",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "zkViewer.exportNodeData.zh",
        "title": "导出节点数据...",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.exportNodeData.en",
        "title": "Export Node Data...",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.exportSubtreeData.zh",
        "title": "导出节点及所有后代数据...",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.exportSubtreeData.en",
        "title": "Export Node and Descendant Data...",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.openImportFormat",
        "title": "%command.openImportFormat.title%",
        "category": "ZooKeeper",
        "icon": "$(code)"
      },
      {
        "command": "zkViewer.openImportFormat.zh",
        "title": "查看导入格式",
        "category": "ZooKeeper",
        "icon": "$(code)"
      },
      {
        "command": "zkViewer.openImportFormat.en",
        "title": "View Import Format",
        "category": "ZooKeeper",
        "icon": "$(code)"
      },
      {
        "command": "zkViewer.setLanguage",
        "title": "%command.setLanguage.title%",
        "category": "ZooKeeper",
        "icon": "$(globe)"
      },
      {
        "command": "zkViewer.setLanguage.zh",
        "title": "界面语言",
        "category": "ZooKeeper",
        "icon": "$(globe)"
      },
      {
        "command": "zkViewer.setLanguage.en",
        "title": "UI Language",
        "category": "ZooKeeper",
        "icon": "$(globe)"
      },
      {
        "command": "zkViewer.openNodeDetail",
        "title": "Open Details",
        "category": "ZooKeeper"
      },
      {
        "command": "zkViewer.setTreeSort",
        "title": "Sort Nodes...",
        "category": "ZooKeeper",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "zkViewer.searchSubtree",
        "title": "Search in this subtree...",
        "category": "ZooKeeper"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zkViewer.addConnection",
          "when": "view == zkViewer.tree",
          "group": "navigation@1"
        },
        {
          "command": "zkViewer.search",
          "when": "view == zkViewer.tree",
          "group": "navigation@2"
        },
        {
          "command": "zkViewer.refresh",
          "when": "view == zkViewer.tree && zkViewer:connected == true",
          "group": "navigation@3"
        },
        {
          "command": "zkViewer.connect",
          "when": "view == zkViewer.tree && zkViewer:connected == false",
          "group": "navigation@4"
        },
        {
          "command": "zkViewer.disconnect",
          "when": "view == zkViewer.tree && zkViewer:connected == true",
          "group": "navigation@5"
        },
        {
          "command": "zkViewer.editConnection",
          "when": "view == zkViewer.tree",
          "group": "zoo@1"
        },
        {
          "command": "zkViewer.removeConnection",
          "when": "view == zkViewer.tree",
          "group": "zoo@2"
        },
        {
          "command": "zkViewer.setTreeSort",
          "when": "view == zkViewer.tree",
          "group": "zoo@3"
        },
        {
          "command": "zkViewer.importNodeData.zh",
          "when": "view == zkViewer.tree && zkViewer:connected == true && zkViewer:uiLanguage == zh-cn",
          "group": "zoo@4"
        },
        {
          "command": "zkViewer.importNodeData.en",
          "when": "view == zkViewer.tree && zkViewer:connected == true && zkViewer:uiLanguage == en",
          "group": "zoo@4"
        },
        {
          "command": "zkViewer.openImportFormat.zh",
          "when": "view == zkViewer.tree && zkViewer:uiLanguage == zh-cn",
          "group": "zoo@5"
        },
        {
          "command": "zkViewer.openImportFormat.en",
          "when": "view == zkViewer.tree && zkViewer:uiLanguage == en",
          "group": "zoo@5"
        },
        {
          "command": "zkViewer.setLanguage.zh",
          "when": "view == zkViewer.tree && zkViewer:uiLanguage == zh-cn",
          "group": "navigation@6"
        },
        {
          "command": "zkViewer.setLanguage.en",
          "when": "view == zkViewer.tree && zkViewer:uiLanguage == en",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "zkViewer.openNodeDetail",
          "when": "view == zkViewer.tree && viewItem == znode",
          "group": "inline@1"
        },
        {
          "command": "zkViewer.addNode",
          "when": "view == zkViewer.tree && viewItem == znode",
          "group": "zoo@1"
        },
        {
          "command": "zkViewer.editNode",
          "when": "view == zkViewer.tree && viewItem == znode",
          "group": "zoo@2"
        },
        {
          "command": "zkViewer.deleteNode",
          "when": "view == zkViewer.tree && viewItem == znode",
          "group": "zoo@3"
        },
        {
          "command": "zkViewer.copyPath",
          "when": "view == zkViewer.tree && viewItem == znode",
          "group": "zoo@4"
        },
        {
          "command": "zkViewer.exportNodeData.zh",
          "when": "view == zkViewer.tree && viewItem == znode && zkViewer:uiLanguage == zh-cn",
          "group": "zoo@5"
        },
        {
          "command": "zkViewer.exportNodeData.en",
          "when": "view == zkViewer.tree && viewItem == znode && zkViewer:uiLanguage == en",
          "group": "zoo@5"
        },
        {
          "command": "zkViewer.exportSubtreeData.zh",
          "when": "view == zkViewer.tree && viewItem == znode && zkViewer:uiLanguage == zh-cn",
          "group": "zoo@6"
        },
        {
          "command": "zkViewer.exportSubtreeData.en",
          "when": "view == zkViewer.tree && viewItem == znode && zkViewer:uiLanguage == en",
          "group": "zoo@6"
        },
        {
          "command": "zkViewer.refresh",
          "when": "view == zkViewer.tree && viewItem == znode",
          "group": "zoo@8"
        },
        {
          "command": "zkViewer.searchSubtree",
          "when": "view == zkViewer.tree && viewItem == znode",
          "group": "zoo@9"
        }
      ],
      "commandPalette": [
        {
          "command": "zkViewer.importNodeData.zh",
          "when": "false"
        },
        {
          "command": "zkViewer.importNodeData.en",
          "when": "false"
        },
        {
          "command": "zkViewer.exportNodeData.zh",
          "when": "false"
        },
        {
          "command": "zkViewer.exportNodeData.en",
          "when": "false"
        },
        {
          "command": "zkViewer.exportSubtreeData.zh",
          "when": "false"
        },
        {
          "command": "zkViewer.exportSubtreeData.en",
          "when": "false"
        },
        {
          "command": "zkViewer.openImportFormat.zh",
          "when": "false"
        },
        {
          "command": "zkViewer.openImportFormat.en",
          "when": "false"
        },
        {
          "command": "zkViewer.setLanguage.zh",
          "when": "false"
        },
        {
          "command": "zkViewer.setLanguage.en",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "ZooKeeper Viewer",
      "properties": {
        "zkViewer.sessionTimeout": {
          "type": "number",
          "default": 10000,
          "description": "ZooKeeper session timeout in milliseconds."
        },
        "zkViewer.maxReconnectAttempts": {
          "type": "number",
          "default": 3,
          "description": "Maximum automatic reconnect attempts before giving up."
        },
        "zkViewer.reconnectDelayMs": {
          "type": "number",
          "default": 2000,
          "description": "Delay between reconnect attempts in milliseconds."
        },
        "zkViewer.maxSearchNodes": {
          "type": "number",
          "default": 500000,
          "description": "Safety cap on the number of nodes visited during a single search (0 = unlimited). When the cap is reached the result list warns that it may be incomplete."
        },
        "zkViewer.maxNodeDataBytes": {
          "type": "number",
          "default": 0,
          "description": "Content search: skip nodes whose data exceeds this size in bytes (0 = no limit, complete results but slower)."
        },
        "zkViewer.treeSort": {
          "type": "string",
          "enum": ["name", "name-desc", "ctime", "ctime-desc", "mtime", "mtime-desc", "none"],
          "default": "name",
          "description": "Sort order for child nodes: by name, creation time or modification time (each ascending or descending), or keep the server order."
        },
        "zkViewer.uiLanguage": {
          "type": "string",
          "enum": ["auto", "zh-cn", "en"],
          "default": "auto",
          "scope": "application",
          "description": "%configuration.uiLanguage.description%"
        },
        "zkViewer.dev.useMockClient": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Development/testing only: use the in-memory mock ZooKeeper client instead of a real connection."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:unit": "npm run compile && mocha \"out/test/unit/**/*.test.js\"",
    "test:unit:cov": "npm run compile && c8 mocha \"out/test/unit/**/*.test.js\"",
    "test:perf": "npm run compile && mocha \"out/test/perf/**/*.test.js\" --timeout 30000",
    "test:integration": "npm run compile && node scripts/run-integration-tests.js",
    "vscode:prepublish": "npm run compile",
    "prepackage": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\"",
    "package": "vsce package --out dist/zk-viewer-vscode.vsix"
  },
  "dependencies": {
    "node-zookeeper-client": "^1.1.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/node-zookeeper-client": "^1.1.0",
    "@types/vscode": "1.60.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "c8": "^10.0.0",
    "eslint": "^9.0.0",
    "mocha": "^10.8.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
